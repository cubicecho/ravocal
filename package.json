{
  "name": "ravocal",
  "version": "1.3.1",
  "private": true,
  "description": "Group scheduling and ranked-choice voting app",
  "type": "module",
  "workspaces": [
    "app",
    "server",
    "db"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "npm run dev -w app",
    "dev:server": "npm run dev -w server",
    "build": "npm run codegen && npm run build -w app",
    "build:app": "npm run build -w app",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run codegen && npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:fix": "biome check --write .",
    "check:types": "tsc -p server --noEmit && tsc -p db --noEmit && tsc -p app --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w db",
    "db:migrate": "npm run migrate -w db",
    "db:push": "npm run push -w db",
    "db:studio": "npm run studio -w db",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "codegen": "npm run codegen:server && npm run codegen:app && npm run codegen:routes",
    "codegen:app": "graphql-codegen --config codegen.ts",
    "codegen:server": "node server/src/graphql/write-schema.ts && graphql-codegen --config codegen.server.ts",
    "codegen:routes": "npm run routes -w app"
  },
  "overrides": {
    "graphql": "16.13.2",
    "drizzle-orm": "1.0.0-rc.5"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@graphql-codegen/schema-ast": "^7.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.1",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
