{
  "name": "ravocal",
  "version": "0.1.0",
  "private": true,
  "description": "Group scheduling and ranked-choice voting app",
  "type": "module",
  "workspaces": [
    "app",
    "server",
    "db"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run build:db && concurrently \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "npm run dev -w app",
    "dev:server": "npm run dev -w server",
    "build": "npm run build:db && npm run codegen && npm run build -w app",
    "build:db": "npm run build -w db",
    "build:app": "npm run build -w app",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run codegen && npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:fix": "biome check --write .",
    "check:types": "npm run build:db && tsc -p server --noEmit && tsc -p db --noEmit && tsc -p app --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w db",
    "db:migrate": "npm run migrate -w db",
    "db:push": "npm run push -w db",
    "db:studio": "npm run studio -w db",
    "codegen": "npm run codegen:server && npm run codegen:app && npm run codegen:routes",
    "codegen:app": "graphql-codegen --config codegen.ts",
    "codegen:server": "graphql-codegen --config codegen.server.ts",
    "codegen:routes": "npm run routes -w app"
  },
  "overrides": {
    "graphql": "16.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/client-preset": "^6.0.0",
    "@graphql-codegen/schema-ast": "^6.0.0",
    "@graphql-codegen/typescript": "^6.0.0",
    "@graphql-codegen/typescript-resolvers": "^6.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^7.0.2",
    "vitest": "^3.1.0"
  }
}
