# Every variable Ravocal reads, each described once. The server reads them only through server/src/core/config.ts.
#
# Development: copy this to .env. `npm run dev` and drizzle-kit read it, and the values set below suit the Postgres and
# Mailpit that `npm run db:up` starts.
# Self-hosting: docker-compose.yml reads a .env beside it and passes these to the container. Write that one fresh,
# with BETTER_AUTH_SECRET and a way to sign in (README.md, Quickstart), rather than copying the development values.
# A commented-out line shows the default, or an example where there is none.

# ---------------------------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------------------------

# The Postgres the server uses. `npm run db:up` starts this one (docker-compose.dev.yml). docker-compose.yml ignores it
# and points the app at its own Postgres service.
DATABASE_URL=postgres://ravocal:ravocal@localhost:5436/ravocal

# better-auth signs sessions with it: anyone who knows it can sign in as anyone. Changing it signs everyone out.
# Generate one with `openssl rand -hex 32`. In production (NODE_ENV=production, as in the image) the server refuses to
# start when it is unset, this placeholder, or shorter than 32 characters; unset in development means a fixed
# development secret.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------------------------------------------------
# Where it is reached
# ---------------------------------------------------------------------------------------------------------------------

# Where people open the app. Sign-in and invite links in emails are built from it, and so are the redirect URIs
# Google and Facebook send readers back to (through SERVER_URL). In development that is the Vite dev server
# (`npm run dev` prints it). Default http://localhost:3001, which is right when the server serves the built app
# itself, as the image does.
APP_URL=http://localhost:5173

# Where a browser reaches this server, for a provider's sign-in: /sso/<provider> starts it and
# /api/auth/callback/<provider> is where the provider sends the reader back. Default APP_URL: in production the
# server serves the app, and in development Vite proxies /graphql, /sso and /api/auth to the server, so the two are
# one origin either way. Set it only when the server is reached at another address than the app.
# SERVER_URL=http://localhost:5173

# The server's port. Default 3001; the Vite dev server proxies to 3001. Under docker-compose.yml the server always
# listens on 3001 inside the container, and this is the host port it is published on.
# PORT=3001

# ---------------------------------------------------------------------------------------------------------------------
# Sign-in methods: set at least one of SMTP_URL, SECURE_LOCAL_NET and a provider (next sections). With none the server
# starts, warns, and nobody can sign in until a provider is paired from the login page.
# ---------------------------------------------------------------------------------------------------------------------

# Outgoing email, as a nodemailer connection URL: smtp://user:pass@host:587, or smtps:// for TLS on connect.
# Sign-in links go out over it, and so do invite and vote emails. This one is the Mailpit `npm run db:up` starts,
# which keeps every email and shows them at http://localhost:8036. Unset, no sign-in links are sent, and invite and
# vote emails are printed to the server's console instead.
SMTP_URL=smtp://localhost:1036
# The From address. Default ravocal@ the host of APP_URL.
# SMTP_FROM=ravocal@example.com

# "true" signs in whoever types an email address, with no link: the network is the credential. For a private
# network only, or for development with no mail server. The server refuses it unless APP_URL's host is private
# (localhost, a dotless name, .lan/.local/.internal/.home.arpa, or a private address), and
# I_KNOW_SECURE_LOCAL_NET_IS_PUBLIC=true overrides that refusal. Both default false.
# SECURE_LOCAL_NET=true
# I_KNOW_SECURE_LOCAL_NET_IS_PUBLIC=false

# ---------------------------------------------------------------------------------------------------------------------
# Providers: Google and Facebook. Set both of a pair or neither: the server refuses to start with one of a pair, and
# with neither the login page offers no button for it. The server prints each redirect URI to register at boot.
# ---------------------------------------------------------------------------------------------------------------------

# Sign in with Google. To get the pair:
#   1. Google Cloud console (https://console.cloud.google.com) > APIs & Services > OAuth consent screen: create it
#      (External), with the app's name, a support email, the app's domain and a privacy-policy link. The scopes are the
#      default openid, email and profile. While it is "Testing", only the test users you list can sign in; publish it
#      to let anyone in.
#   2. Credentials > Create credentials > OAuth client ID > Web application. Authorized redirect URI, exactly:
#        <SERVER_URL>/api/auth/callback/google      (http://localhost:5173/api/auth/callback/google in development)
#      No JavaScript origin is needed: the browser never calls Google itself.
#   3. Copy the client ID and secret here.
# An address Google says it checked signs in to the Ravocal account that has it, even one never confirmed by an email
# link; one Google has not checked is refused when an account already has it.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Sign in with Facebook. To get the pair:
#   1. Meta for Developers (https://developers.facebook.com) > My Apps > Create app, with the "Authenticate and request
#      data from users with Facebook Login" use case. Ask for the email permission beside public_profile.
#   2. Facebook Login > Settings: Valid OAuth Redirect URIs, exactly:
#        <SERVER_URL>/api/auth/callback/facebook    (http://localhost:5173/api/auth/callback/facebook in development)
#      Keep "Client OAuth login", "Web OAuth login" and "Enforce HTTPS" on; Meta allows http://localhost while the app
#      is in development mode.
#   3. App settings > Basic: the App ID is FACEBOOK_CLIENT_ID and the App secret is FACEBOOK_CLIENT_SECRET. Before the
#      app can go live (anyone, not only its admins, developers and testers), Meta requires a privacy-policy URL and
#      data-deletion instructions (a URL, or a callback) on this page, plus an app icon and a category.
# Facebook is not trusted with an address: a Facebook sign-in whose address an account already has is refused, and the
# reader is told to sign in by email and connect Facebook in Settings. A new address makes a new account.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# Your own OpenID Connect provider (heautou, Keycloak, Authentik, ...), as a "Continue with <name>" button.
# ---------------------------------------------------------------------------------------------------------------------

# Two ways to set it up, and the environment wins:
#   - Pair it from the app, with no variables at all: a provider that does Dynamic Client Registration gives its admin
#     a setup URL for Ravocal (<issuer>#setup=<token>&name=<label>). On an instance with no accounts yet the login
#     page offers "Set up sign-in"; afterwards the admin (the first account) does it in Settings, "Single sign-on".
#     The setup URL works once, and its token is never stored or logged.
#   - Set OIDC_ISSUER and OIDC_CLIENT_ID here. Register a client at the provider with this redirect URI, exactly:
#        <SERVER_URL>/api/auth/callback/oidc       (http://localhost:5173/api/auth/callback/oidc in development)
#     Then the app shows the provider but cannot change it. The server refuses to start with one of the two set and
#     not the other, with an issuer that is not an http(s) URL, or with an OIDC_CLIENT_AUTH it does not know.
# Like Google, the provider's own email_verified claim decides whether a sign-in reaches the account that already has
# its address; a missing claim counts as unchecked.
# The issuer URL: its discovery document is <OIDC_ISSUER>/.well-known/openid-configuration.
# OIDC_ISSUER=https://id.example.com/oidc
# OIDC_CLIENT_ID=
# The client's secret. Unset for a public client, which proves itself with PKCE alone.
# OIDC_CLIENT_SECRET=
# How the secret is sent to the token endpoint: client_secret_basic (default) or client_secret_post.
# OIDC_CLIENT_AUTH=client_secret_basic
# What the login page's button calls the provider: "Continue with <OIDC_NAME>". Default SSO.
# OIDC_NAME=SSO

# ---------------------------------------------------------------------------------------------------------------------
# Behind a reverse proxy
# ---------------------------------------------------------------------------------------------------------------------

# Proxies in front of this server that may set X-Forwarded-For. Default false (none).
# "1" for one reverse proxy (Caddy, Traefik, nginx); or "loopback", "uniquelocal", or a list of addresses.
# Without it behind a proxy, every visitor shares the proxy's sign-in rate limit. Never "true" when the port is
# reachable from the internet: any client could then choose its own address, and the sign-in rate limit keys on it.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------------------------------------

# "production" turns on preflight's BETTER_AUTH_SECRET check and turns off GraphiQL. The image sets it.
# NODE_ENV=production

# How long the server waits for Postgres at boot before giving up, in ms. Default 60000.
# DB_CONNECT_TIMEOUT_MS=60000

# docker-compose.yml only: the password of its Postgres, which nothing outside the compose network can reach.
# Default ravocal. Set it before the first `docker compose up`: Postgres keeps the password its volume was made with.
# POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# Development (docker-compose.dev.yml)
# ---------------------------------------------------------------------------------------------------------------------

# The host port the dev Postgres is published on. Default 5436. Change DATABASE_URL to match.
# POSTGRES_PORT=5436

# The host ports Mailpit's SMTP and web UI are published on. Defaults 1036 and 8036. Change SMTP_URL to match.
# MAILPIT_SMTP_PORT=1036
# MAILPIT_UI_PORT=8036

# The address the dev Postgres and Mailpit bind to. Default 127.0.0.1. Set 0.0.0.0 when the Docker daemon is remote
# (`docker context ls`), because 127.0.0.1 there is the daemon host's loopback, and put the daemon's host in
# DATABASE_URL and SMTP_URL.
# DEV_BIND=127.0.0.1
