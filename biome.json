{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "plugins": ["./no-negation.grit"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/__generated__",
      "!**/drizzle",
      "!**/storybook-static",
      "!app/cubeui-tokens.css",
      "!app/cubeui-reset.css"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "style": {
        "useImportType": "error",
        "useConst": "error",
        "useBlockStatements": "error",
        "noMagicNumbers": "warn",
        "noCommonJs": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterProperties": "error",
        "noNonNullAssertion": "error",
        "useFilenamingConvention": { "level": "error", "options": { "filenameCases": ["kebab-case"] } }
      },
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": [
        "**/components/ui/**",
        "app/index.html",
        "app/src/components/app-form.tsx",
        "app/src/components/card-layout.tsx",
        "app/src/components/centered-card-layout.tsx",
        "app/src/components/combobox.tsx",
        "app/src/components/empty-state.tsx",
        "app/src/components/form-field.tsx",
        "app/src/components/header-content-footer.tsx",
        "app/src/components/list-item.tsx",
        "app/src/components/list.tsx",
        "app/src/components/load-state.tsx",
        "app/src/components/page-header.tsx",
        "app/src/components/page-layout.tsx",
        "app/src/components/password-input.tsx",
        "app/src/components/section-heading.tsx",
        "app/src/components/section.tsx",
        "app/src/lib/color.ts",
        "app/src/lib/error-message.ts",
        "app/src/lib/form-binding.ts",
        "app/src/lib/frame-focus-guard.ts",
        "app/src/lib/number-draft.ts",
        "app/src/lib/readable-text-color.ts",
        "app/src/lib/roving-focus.ts",
        "app/src/lib/select-options.ts",
        "app/src/lib/utils.ts"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["app/src/routes/**"],
      "linter": { "rules": { "style": { "useFilenamingConvention": "off" } } }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**", "**/bench/**"],
      "linter": { "rules": { "style": { "noMagicNumbers": "off" } } }
    }
  ]
}
