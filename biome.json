{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.css",
      "!**/dist",
      "!**/__generated__",
      "!**/drizzle",
      "!**/node_modules",
      "!app/cubeui-tokens.css",
      "!app/cubeui-reset.css"
    ]
  },
  "overrides": [
    {
      "includes": [
        "app/src/components/ui/**",
        "app/src/components/app-form.tsx",
        "app/src/components/card-layout.tsx",
        "app/src/components/centered-card-layout.tsx",
        "app/src/components/combobox.tsx",
        "app/src/components/empty-state.tsx",
        "app/src/components/form-field.tsx",
        "app/src/components/header-content-footer.tsx",
        "app/src/components/list-item.tsx",
        "app/src/components/list.tsx",
        "app/src/components/load-state.tsx",
        "app/src/components/page-header.tsx",
        "app/src/components/page-layout.tsx",
        "app/src/components/password-input.tsx",
        "app/src/components/section-heading.tsx",
        "app/src/components/section.tsx",
        "app/src/lib/color.ts",
        "app/src/lib/error-message.ts",
        "app/src/lib/form-binding.ts",
        "app/src/lib/frame-focus-guard.ts",
        "app/src/lib/number-draft.ts",
        "app/src/lib/readable-text-color.ts",
        "app/src/lib/roving-focus.ts",
        "app/src/lib/select-options.ts",
        "app/src/lib/utils.ts"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
